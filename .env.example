# Application Environment Variables
BASE_URL=/shreyansir

# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_NAME=online_exam
DB_USER=exam_user
DB_PASS=exam_password

# MariaDB Root Credentials
MARIADB_ROOT_PASSWORD=root_secret

# Image Storage & Cloudinary Configuration
IMAGE_STORAGE_DRIVER=local
IMAGE_COMPRESS_QUALITY=75
IMAGE_MAX_WIDTH=1200
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=questions

# OpenRouter AI Question Generator Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_TEMPERATURE=0.7
